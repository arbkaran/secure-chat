# Neon Postgres — use the pooled connection string, keep sslmode=require
DATABASE_URL=postgresql+psycopg2://app_user:password@ep-example-12345.us-east-2.aws.neon.tech/secure_messenger?sslmode=require

# JWT
JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# SMTP (email OTP delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com
